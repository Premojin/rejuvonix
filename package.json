{
  "name": "rejuvonix",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/homepage-interactions.test.mjs tests/staging-contracts.test.mjs tests/route-links.test.mjs tests/postgres-baseline.test.mjs && node --experimental-strip-types --test tests/authorization.test.mjs tests/clinical-runtime.test.mjs tests/provider-boundary.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "governance:validate": "node scripts/validate-governance.mjs",
    "smoke:staging": "bash scripts/staging-smoke.sh",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate:postgres": "node --experimental-strip-types scripts/migrate-postgres.ts"
  },
  "dependencies": {
    "aws-jwt-verify": "^5.2.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.2",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260822.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module",
  "displayName": "Rejuvonix",
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "ajv": {
      "fast-uri": "3.1.5"
    }
  }
}
